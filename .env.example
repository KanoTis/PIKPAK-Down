# Required: base64url-encoded 32-byte key. Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
APP_SECRET_KEY=

DATA_DIR=/data
DOWNLOADS_DIR=/downloads
CACHE_DIR=/cache
DUPLICATE_NAME_POLICY=rename
# DATABASE_URL=sqlite+aiosqlite:////data/pikpak.db

PIKPAK_DRIVE_BASE_URL=https://api-drive.mypikpak.com
PIKPAK_USER_BASE_URL=https://user.mypikpak.com

DOWNLOAD_MAX_CONCURRENCY=2
ARIA2_SPLIT=8
ARIA2_MAX_CONNECTION_PER_SERVER=8
ARIA2_MIN_SPLIT_SIZE=8M
DOWNLOAD_MAX_RATE=0

ANON_API_QPS=5
SHARE_PROBE_QPS=2
WINDOW_PROBE_QPS=2

LINEAGE_MAX_ACTIVE_RUNS=1
LINEAGE_MAX_DEPTH=5
LINEAGE_MAX_REQUESTS=2000
LINEAGE_MAX_SHARES=200
LINEAGE_MAX_FOLDERS=2000
LINEAGE_MAX_ITEMS=50000

ACCOUNT_DAILY_RESET_TZ=Asia/Shanghai
ACCOUNT_LEASE_SECONDS=1800
ACCOUNT_COOLDOWN_SECONDS=300

# Host bind mounts for docker compose
DOWNLOADS_HOST_DIR=./downloads
CACHE_HOST_DIR=./cache
